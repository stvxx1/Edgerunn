# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEY_BACKUP: Optional failover API key when primary key runs out of quota.
GEMINI_API_KEY_BACKUP=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AI_HORDE_API_KEY: Optional key for the Scene Visualiser (https://aihorde.net/register).
# Without it requests run anonymously at the lowest queue priority.
AI_HORDE_API_KEY=""

# COMFYUI_URL: Local ComfyUI for the Scene Visualiser's "Local GPU" backend.
# Leave empty to auto-detect ComfyUI on port 8188 (portable/CLI) or 8000 (ComfyUI Desktop),
# or set it to override, e.g. "http://192.168.1.50:8188" for ComfyUI on another machine.
COMFYUI_URL=""

# ALLOWED_HOSTS: Extra hostnames the dev server will answer to (comma-separated),
# e.g. your PC's Tailscale name "gaming-pc". *.ts.net and IP addresses already work.
ALLOWED_HOSTS=""

# Optional: override which Gemini models are tried, in order, comma-separated. When one is out of quota
# or overloaded the next is used. Leave empty to use the built-in lists.
# Vertex AI (Google Cloud billing, so your Cloud credit applies). Use ONE of these; the AI Studio key above
# then becomes the backup. Project route needs: gcloud auth application-default login
GEMINI_VERTEX_PROJECT=""
GEMINI_VERTEX_LOCATION="global"
# Or a Vertex "express mode" API key from Cloud Console > Vertex AI > API keys
GEMINI_VERTEX_API_KEY=""
# GEMINI_CHAT_MODELS: the GM's replies (put your best-prose model first)
GEMINI_CHAT_MODELS=""
# GEMINI_HELPER_MODELS: image prompt writer and story summariser
GEMINI_HELPER_MODELS=""

# Optional local model for the helper jobs (image prompt writer, story summariser). Edgerunn finds
# Ollama (port 11434) or LM Studio (port 1234) on this machine by itself; nothing is needed here.
# It is used when Gemini is out of quota, or first if HELPER_PREFER="local". See docs/LOCAL_LLM_HELPER.md
# LOCAL_LLM_URL: only for a model on another machine, e.g. "http://192.168.1.50:11434"
LOCAL_LLM_URL=""
# LOCAL_LLM_MODEL: only to pick a specific model, e.g. "llama3.2:3b"; otherwise a small chat model is chosen
LOCAL_LLM_MODEL=""
# HELPER_PREFER: "local" tries the local model before Gemini (saves Gemini's free quota for the GM)
HELPER_PREFER=""

